{
  "name": "froggion-homepage",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite build && vite preview",
    "data": "node --no-deprecation tools/prepare-skins.js && node --no-deprecation tools/replay-to-timeline.js",
    "data:suggest-loops": "node --no-deprecation tools/replay-to-timeline.js --suggest",
    "textures": "node tools/draw-textures.js",
    "brand": "node tools/prepare-brand.js",
    "fonts": "node tools/prepare-fonts.js",
    "posters": "vite build && node tools/render-poster.js",
    "screenshots": "vite build && node tools/screenshots.js",
    "check": "node --no-deprecation --test tools/test/*.test.js && vite build && node tools/check-budget.js",
    "budget": "node tools/check-budget.js"
  },
  "devDependencies": {
    "jszip": "^3.10.2",
    "minecraft-data": "^3.117.0",
    "minecraft-protocol": "^1.68.0",
    "playwright": "^1.63.0",
    "pngjs": "^7.0.0",
    "prismarine-chunk": "^1.41.0",
    "sharp": "^0.35.4",
    "three": "^0.186.1",
    "vite": "^8.3.1"
  }
}
